<org.fedorahosted.freeotp.token.TokenLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tool="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_1"
    android:background="?android:selectableItemBackground">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="72dp">

        <View
            android:id="@+id/image_bg"
            android:layout_width="72dp"
            android:layout_height="0dp"
            android:background="@color/token_background"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <ImageView
            android:id="@+id/image"
            android:layout_width="72dp"
            android:layout_height="0dp"
            android:src="@drawable/logo"
            android:scaleType="fitCenter"
            android:padding="12dp"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintStart_toStartOf="@+id/image_bg"
            app:layout_constraintEnd_toEndOf="@+id/image_bg"
            app:layout_constraintTop_toTopOf="@+id/image_bg"
            app:layout_constraintBottom_toBottomOf="@+id/image_bg"/>

        <org.fedorahosted.freeotp.ui.ProgressCircle
            android:id="@+id/progressInner"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:padding="22dp"
            app:hollow="false"
            app:max="1000"
            app:layout_constraintStart_toStartOf="@+id/image"
            app:layout_constraintEnd_toEndOf="@+id/image"
            app:layout_constraintTop_toTopOf="@+id/image"
            app:layout_constraintBottom_toBottomOf="@+id/image" />

        <org.fedorahosted.freeotp.ui.ProgressCircle
            android:id="@+id/progressOuter"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:padding="18dp"
            app:hollow="true"
            app:max="1000"
            app:layout_constraintStart_toStartOf="@+id/image"
            app:layout_constraintEnd_toEndOf="@+id/image"
            app:layout_constraintTop_toTopOf="@+id/image"
            app:layout_constraintBottom_toBottomOf="@+id/image" />

        <FrameLayout
            android:id="@+id/token_content"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/image_bg"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:id="@+id/titles_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingStart="8dp"
                android:paddingEnd="40dp">
                <include layout="@layout/titles" />
            </LinearLayout>

            <TextView
                android:id="@+id/code"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="end|center_vertical"
                android:paddingStart="8dp"
                android:paddingEnd="64dp"
                android:textSize="32sp"
                android:textStyle="bold"
                android:typeface="monospace"
                android:visibility="gone"
                tool:text="01234567"
                tool:visibility="visible" />
        </FrameLayout>

        <ImageView
            android:id="@+id/menu"
            android:layout_width="32dp"
            android:layout_height="0dp"
            android:layout_marginEnd="@dimen/space_2"
            android:src="@drawable/menu"
            app:tint="@color/overflow_menu"
            android:tintMode="add"
            android:scaleType="centerInside"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="@+id/token_content"
            app:layout_constraintTop_toTopOf="@+id/token_content" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</org.fedorahosted.freeotp.token.TokenLayout>
